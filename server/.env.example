# Server Port
PORT=5000

# PostgreSQL Connection String
# Local Docker: postgres://sweety_user:sweety_password@localhost:5432/sweety_db
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://sweety_user:sweety_password@localhost:5432/sweety_db

# JWT Secret Key (must be at least 32 characters in production)
JWT_SECRET=sweety_super_secret_jwt_key_at_least_32_characters_long_for_security

# Node Environment (development | production | test)
NODE_ENV=development

# Frontend Client URL (for CORS allowlist)
CLIENT_URL=http://localhost:5173
